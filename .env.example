# Copy this file to .env and fill in the values. Only names are listed here - no secrets.
# VITE_* values are inlined into the browser bundle at build time, so keep secrets out of them.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Scheduled job secrets, if you use them.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# Local development only: add these to .env.local, never to VITE_* variables.
# AI_PROVIDER=kilo
# KILO_AI_MODEL=nvidia/nemotron-3.5-super-vl:free
# KILO_API_KEY=  # Optional for the free model.
# Lovable uses its managed LOVABLE_API_KEY and optional LOVABLE_AI_MODEL.
